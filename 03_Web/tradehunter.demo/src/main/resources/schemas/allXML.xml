<?xml version="1.0" encoding="UTF-8" ?>
<entity-mappings xmlns="http://xmlns.jcp.org/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence/orm
    http://xmlns.jcp.org/xml/ns/persistence/orm_2_2.xsd"
    version="2.2">

    <entity class="com.mondragon.tradehunter.demo.model.User" name="User">
        <attributes>
            <id name="userID"/>
            <basic name="name"></basic>
            <basic name="surname"></basic>
            <basic name="username"></basic>
            <basic name="password"></basic>
            <basic name="email"></basic>
            <basic name="age"></basic>
            <basic name=""></basic>
            <one-to-many name="messages" target-entity="com.mondragon.tradehunter.demo.model.Message" mapped-by="user"/>
        </attributes>
    </entity>

    <!-- Puedes agregar más entidades y relaciones aquí -->

</entity-mappings>
